# NOVA FITNESS — environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# ---- Supabase (frontend, safe to expose) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where magic links return the user.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server only -------------------------------------------------------------
# NEVER prefix these with NEXT_PUBLIC_, never ship them to the browser or ESP32.
# Only used by the one-off bootstrap script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Super admin bootstrap ---------------------------------------------------
# Consumed once by `node scripts/bootstrap-super-admin.mjs`, then rotate/remove.
# The spec's nuwan/1234 is a development credential only — set a real password here.
SUPER_ADMIN_USERNAME=nuwan
SUPER_ADMIN_EMAIL=owner@novafitness.lk
SUPER_ADMIN_PASSWORD=change-me-before-production

# ---- Device provisioning -----------------------------------------------------
# Used by `node scripts/provision-device.mjs GYM-001` to mint a device key.
# The generated key goes into the ESP32's NVS, not into this file.
